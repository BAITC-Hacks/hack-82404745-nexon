BOT_TOKEN=
# Публичный HTTPS-адрес (например, ngrok-туннель поверх localhost:API_PORT).
# Нужен только для кнопки Telegram Mini App в боте; без него бот работает как обычно, просто без этой кнопки.
TELEGRAM_WEBAPP_URL=

# OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NVIDIA provider (Nim)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Active LLM (openai or nvidia)
LLM_PROVIDER=openai

API_HOST=0.0.0.0
API_PORT=8791
LLM_TIMEOUT_SECONDS=7
